# Copy to .env and fill in. Never commit .env.
# Use letters and digits only in MONGO_PASS (it goes into a connection URL).
MONGO_USER=portfolio
MONGO_PASS=replace-with-a-long-alphanumeric-password
# Token for updating content via the API. Generate with: openssl rand -hex 24
ADMIN_TOKEN=replace-with-a-long-random-token

# Where the site listens on the host. 127.0.0.1 = only this machine (put a TLS reverse
# proxy such as Caddy in front). Use 0.0.0.0 only if nothing else sits in front.
WEB_BIND=127.0.0.1
WEB_PORT=8080
